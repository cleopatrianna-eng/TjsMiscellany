html---
layout: base.njk
title: Journal
---

<div class="page-hero">
  <div class="page-hero-inner">
    <p class="section-eyebrow">Writings</p>
    <h1>The Journal</h1>
    <p>Essays, reflections, and dispatches from a life lived among books</p>
  </div>
</div>

<div class="page-wrapper">
  <div class="card-grid">
    {% for post in collections.posts | reverse %}
    <article class="card">
      <div class="card-image">
        <img src="{{ post.data.image }}" alt="{{ post.data.title }}">
        <span class="card-tag">{{ post.data.category }}</span>
      </div>
      <div class="card-body">
        <p class="card-date">{{ post.date | date: "%d %B %Y" }}</p>
        <h3 class="card-title">{{ post.data.title }}</h3>
        <p class="card-excerpt">{{ post.data.excerpt }}</p>
        <a href="{{ post.url }}" class="card-link">Continue Reading →</a>
      </div>
    </article>
    {% endfor %}
  </div>
</div>